# Domain
WORKSPACE_DOMAIN=doe.delhi.gov.in

# Protect deployed API routes. Send this as either:
# Authorization: Bearer <token>
# x-api-key: <token>
API_SECRET_TOKEN=

# Employee data API
EMPLOYEE_API_URL=
EMPLOYEE_API_KEY=

# Google Workspace Admin SDK
GOOGLE_ADMIN_IMPERSONATE_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative for Vercel if raw JSON quoting is awkward:
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# DOE tablet API overrides are optional. Defaults are built in.
DOE_TABLET_API_URL=
DOE_TABLET_GET_API_URL=
DOE_TABLET_POST_API_URL=

# SMTP for notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
