# Domain
WORKSPACE_DOMAIN=doe.delhi.gov.in

# Protect deployed API routes. Send this as either:
# Authorization: Bearer <token>
# x-api-key: <token>
API_SECRET_TOKEN=

# Employee data API
EMPLOYEE_API_URL=
EMPLOYEE_API_KEY=

# Google Workspace Admin SDK
GOOGLE_ADMIN_IMPERSONATE_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative for Vercel if raw JSON quoting is awkward:
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# DOE tablet API overrides are optional. Defaults are built in.
DOE_TABLET_API_URL=
DOE_TABLET_GET_API_URL=
DOE_TABLET_POST_API_URL=

# SMTP for notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Postgres (Vercel Storage -> Postgres, Neon-backed). Populated automatically
# by `vercel env pull` once a database is attached to the project.
DATABASE_URL=

# Admin dashboard (/admin) login
ADMIN_PASSWORD=
# Random 32+ char secret used to sign admin session cookies, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# Kill switch (Vercel Edge Config — see README.md for setup). EDGE_CONFIG is
# auto-populated by Vercel once a store is connected to the project;
# EDGE_CONFIG_ID/VERCEL_TEAM_ID identify it for writes. VERCEL_ACCESS_TOKEN
# needs Edge Config write access — create at https://vercel.com/account/tokens.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_TEAM_ID=
VERCEL_ACCESS_TOKEN=
